{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/services/:id*",
      "destination": "/api/services"
    },
    {
      "source": "/api/quotes/:id*",
      "destination": "/api/quotes"
    }
  ]
}
